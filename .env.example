# Bearer token required for all MCP tool endpoints (not /health)
MCP_API_TOKEN=change-me-to-a-long-random-token

# Path to the Tesseract OCR binary (UB Mannheim installer default)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Directory where recorded MP4 files are written (created if missing)
OUTPUT_DIR=recordings

# Capture frame rate for recordings
FPS=30

# Host interface uvicorn binds to
HOST=127.0.0.1

# Port uvicorn listens on
PORT=8000
